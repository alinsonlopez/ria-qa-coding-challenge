{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "mocha"]
  },
  "include": ["pages/**/*.ts", "support/**/*.ts", "tests/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "dist", "artifacts"]
}
